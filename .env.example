# ===== 助教小老师 little-tutor 环境变量模板 =====
# 复制为 .env 后填入真实值：cp .env.example .env

# OpenAI 兼容接口（可用 DeepSeek / 通义千问 / 智谱等）
OPENAI_API_KEY=你的API
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# 老师入口共享令牌；留空表示本地演示模式不校验
TUTOR_TEACHER_TOKEN=

# 数据库（默认 SQLite，一般无需修改）
# DATABASE_URL=sqlite:///tutor.db

# HuggingFace 镜像（国内访问 huggingface.co 常超时，默认走镜像）
HF_ENDPOINT=https://hf-mirror.com
